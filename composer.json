{
	"name": "dobrzepostawieni/primeplaced-withdrawal-button",
	"description": "EU right of withdrawal for WooCommerce: withdrawal button, form, request number, durable-medium confirmation, request panel and refunds.",
	"homepage": "https://dobrzepostawieni.pl/withdrawal-button/",
	"license": "GPL-3.0-or-later",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Kamil Jonik",
			"email": "kamil@dobrzepostawieni.pl",
			"homepage": "https://dobrzepostawieni.pl"
		}
	],
	"require": {
		"php": ">=8.1",
		"dompdf/dompdf": "^3.1",
		"freemius/wordpress-sdk": "^2.13",
		"inpsyde/wp-context": "^1.7"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"brianhenryie/strauss": "^0.22",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/woocommerce-stubs": "^9.0",
		"php-stubs/wordpress-tests-stubs": "^7.1",
		"php-stubs/wp-cli-stubs": "^2.12",
		"phpstan/phpstan-deprecation-rules": "^1.2",
		"phpunit/phpunit": "^9.6",
		"slevomat/coding-standard": "^8.14",
		"squizlabs/php_codesniffer": "^3.13",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"PrimePlaced\\WithdrawalButton\\Backend\\": "Backend/",
			"PrimePlaced\\WithdrawalButton\\Blocks\\": "Blocks/",
			"PrimePlaced\\WithdrawalButton\\Data\\": "Data/",
			"PrimePlaced\\WithdrawalButton\\Domain\\": "Domain/",
			"PrimePlaced\\WithdrawalButton\\Emails\\": "Emails/",
			"PrimePlaced\\WithdrawalButton\\Engine\\": "Engine/",
			"PrimePlaced\\WithdrawalButton\\Frontend\\": "Frontend/",
			"PrimePlaced\\WithdrawalButton\\Integrations\\": "Integrations/",
			"PrimePlaced\\WithdrawalButton\\Pdf\\": "Pdf/",
			"PrimePlaced\\WithdrawalButton\\Privacy\\": "Privacy/",
			"PrimePlaced\\WithdrawalButton\\Rest\\": "Rest/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"PrimePlaced\\WithdrawalButton\\Tests\\": "tests/"
		}
	},
	"extra": {
		"strauss": {
			"target_directory": "vendor-prefixed",
			"namespace_prefix": "PrimePlaced\\WithdrawalButton\\Vendor\\",
			"classmap_prefix": "PPWB_Vendor_",
			"constant_prefix": "PPWB_VENDOR_",
			"packages": [
				"dompdf/dompdf",
				"inpsyde/wp-context"
			],
			"delete_vendor_packages": false
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.1.31"
		},
		"sort-packages": true
	},
	"scripts": {
		"prefix-namespaces": [
			"strauss",
			"@php bin/fix-prefixed.php",
			"@composer dump-autoload"
		],
		"post-install-cmd": [
			"@prefix-namespaces"
		],
		"post-update-cmd": [
			"@prefix-namespaces"
		],
		"phpstan": "phpstan analyse --memory-limit=2G",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"test:unit": "phpunit -c phpunit.xml.dist --testdox",
		"test:integration": "phpunit -c phpunit.integration.xml.dist --testdox"
	}
}
